# Existing absolute paths on the Docker host, not on a remote Docker client.
ARK_MEDIA=/srv/ark-media
# Can be on the same external drive. Must be writable by container UID 1000.
ARK_CONFIGURATION=/srv/ark-media/DATA-ARK-CONFIG/config
ARK_BIND=0.0.0.0
ARK_PORT=8088
ARK_IMAGE=dataark:local
# Set to the source Git commit when building a versioned image.
ARK_REVISION=development
