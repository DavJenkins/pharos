{
  "schema": 1,
  "enabled": true,
  "interval": "7d",
  "notes": [
    "Only publisher-specific reviewed patterns are used. Candidate editions are not queued downloads.",
    "Tax year, annual edition and publication date are distinct. Prior editions remain installed.",
    "kind=index prefers links on an explicit publisher index; templates support bounded year/month/day windows."
  ],
  "rules": {
    "forms-f1040-2025": {
      "kind": "dated_template",
      "directory_template": "https://www.irs.gov/pub/irs-prior/",
      "filename_template": "f1040--{year}.pdf",
      "period": "year",
      "period_kind": "tax_year",
      "current_edition": "2025",
      "lookback": 2,
      "lookahead": 1,
      "max_probes": 4,
      "edition_text_pattern": "\\b{year}\\b",
      "action": "review",
      "retain_previous": true
    },
    "forms-i1040gi-2025": {
